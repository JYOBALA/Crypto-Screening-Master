# Salin file ini ke .env dan isi nilainya. JANGAN commit .env (sudah di .gitignore).
# Cara membuat bot/webhook & mendapatkan nilai-nilai ini: lihat DEPLOY.md.

# Pilih target output ide_trade harian: xlsx (ide_trade.xlsx, default), gsheet
# (Google Sheets -- bisa dibuka dari HP tanpa transfer file), atau both.
OUTPUT_TARGET=xlsx

# --- gsheet (kalau OUTPUT_TARGET=gsheet atau both) ---
# ID spreadsheet: bagian di URL antara /d/ dan /edit --
# https://docs.google.com/spreadsheets/d/INI_ID_NYA/edit
GSHEET_ID=
# Path file JSON kredensial service account (lihat DEPLOY.md cara membuatnya).
# File ini SAMA SENSITIFNYA dgn .env -- JANGAN commit, chmod 600 di VPS.
GSHEET_CREDENTIALS=gsheet_credentials.json
GSHEET_WORKSHEET=ide_trade

# Pilih SATU kanal notifikasi: telegram, ntfy, discord, email, none.
# Default kalau tidak diset: telegram (kompatibel dgn setup lama).
# NOTIFY_CHANNEL=none melewati pengiriman TANPA error -- output (xlsx/gsheet)
# tetap ditulis seperti biasa, ini bukan mode "gagal". Kalau OUTPUT_TARGET
# sudah gsheet, "none" jadi pilihan wajar -- tinggal buka spreadsheet dari HP.
NOTIFY_CHANNEL=telegram

# --- telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAexampleTokenFromBotFather
TELEGRAM_CHAT_ID=123456789

# --- ntfy (https://ntfy.sh atau server ntfy sendiri) ---
NTFY_TOPIC=screener-harian-anda-ganti-ini
# NTFY_SERVER=https://ntfy.sh          # opsional, default https://ntfy.sh
# NTFY_TOKEN=                          # opsional, kalau topic butuh auth

# --- discord (webhook channel) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# --- email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akun-pengirim@gmail.com
SMTP_PASSWORD=app-password-bukan-password-akun
EMAIL_FROM=akun-pengirim@gmail.com
EMAIL_TO=email-tujuan-anda@example.com
