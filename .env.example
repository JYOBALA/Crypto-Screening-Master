# Salin file ini ke .env dan isi nilainya. JANGAN commit .env (sudah di .gitignore).
# Cara membuat bot/webhook & mendapatkan nilai-nilai ini: lihat DEPLOY.md.

# Pilih SATU kanal notifikasi: telegram, ntfy, discord, email, none.
# Default kalau tidak diset: telegram (kompatibel dgn setup lama).
# NOTIFY_CHANNEL=none melewati pengiriman TANPA error -- ide_trade.xlsx tetap
# ditulis seperti biasa, ini bukan mode "gagal".
NOTIFY_CHANNEL=telegram

# --- telegram ---
TELEGRAM_BOT_TOKEN=123456789:AAexampleTokenFromBotFather
TELEGRAM_CHAT_ID=123456789

# --- ntfy (https://ntfy.sh atau server ntfy sendiri) ---
NTFY_TOPIC=screener-harian-anda-ganti-ini
# NTFY_SERVER=https://ntfy.sh          # opsional, default https://ntfy.sh
# NTFY_TOKEN=                          # opsional, kalau topic butuh auth

# --- discord (webhook channel) ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/yyyyy

# --- email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=akun-pengirim@gmail.com
SMTP_PASSWORD=app-password-bukan-password-akun
EMAIL_FROM=akun-pengirim@gmail.com
EMAIL_TO=email-tujuan-anda@example.com
