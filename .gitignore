# Cache data harga (di-regenerate otomatis tiap hari)
.cache/
# Arsip sejarah panjang untuk backtest (dibuat fetch_history.py, besar)
.cache_history/
# Arsip order flow (dibuat fetch_orderflow.py, besar; termasuk universe_*.json)
.cache_orderflow/
# Jurnal trade (journal.py) -- data pribadi user, tidak otomatis dicommit.
# Append-only + ter-hash; backup manual jadi tanggung jawab user kalau mau disimpan.
journal.jsonl
# Secret bot Telegram -- JANGAN pernah dicommit.
.env
*.log
__pycache__/
*.pyc

# Hasil screening JSON (besar). CSV SENGAJA di-commit —
# nanti jadi bahan backtest untuk menyetel bobot skor.
*.json
# ...tapi universe yang dibekukan untuk KRITERIA_EVALUASI.md/daily_run.py
# WAJIB di-commit -- itu bukan output, itu definisi eksperimen.
!universe_frozen.json
# Output harian dashboard (di-regenerate tiap cron run) -- bukan sumber kebenaran.
data/

# Scratch / artefak run (jangan commit)
scratch_*

# Arsip artefak riset selesai (backtest/factor_test/mechanics_test/dst).
# Isinya SUDAH di-commit lewat `git mv` sebelum baris ini ditambahkan
# (lihat commit "bersihkan root: pindahkan artefak riset selesai ke
# arsip/") -- gitignore tidak melepas file yang sudah dilacak, ini cuma
# mencegah output scratch BARU di folder ini ikut ter-commit otomatis.
arsip/*
!arsip/backtest_trades.csv
!arsip/orderflow_ic_results.csv
!arsip/screening_daily_20260831_0619.csv
!arsip/screening_daily_20260901_0119.csv
!arsip/screening_gem_20260901_0120.csv
!arsip/screening_gem_20260901_0135.csv
